* text=auto

# Canonical text line endings for reproducible hashes across checkouts
*.md   text eol=lf
*.txt  text eol=lf
*.cff  text eol=lf
*.json text eol=lf
*.csv  text eol=lf
*.tsv  text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.R    text eol=lf
*.py   text eol=lf
*.ps1  text eol=lf
*.sh   text eol=lf
*.xml  text eol=lf

# Binary assets
*.pdf  binary
*.png  binary
*.tiff binary
*.tif  binary
*.rds  binary
*.RData binary
*.docx binary
*.zip  binary
*.gz   binary
